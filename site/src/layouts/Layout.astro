---
const { title, description } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11120f" />
    <title>{title}</title>
    <meta name="description" content={description ?? "Extensions for the Silo code editor"} />

    <!-- Same icon set as getsilo.dev (apps/docs/public/), not a placeholder. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Same fonts as the getsilo.dev marketing homepage (apps/website/index.html). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap"
    />

    <!-- First paint: never flash white while the external stylesheet loads
         (mirrors apps/docs/.vitepress/config.ts's silo-first-paint
         injection). background-color longhand only — the real background
         rule (in the global <style> below) sets background-image via a
         layered gradient with no trailing solid color, so this and that
         rule never fight over the same longhand property regardless of
         cascade order. Using the `background` shorthand here instead would
         reset background-image back to `none` once this rule's later in
         the cascade than the stylesheet's, silently killing the gradient
         (that's exactly what happened before this comment existed). -->
    <style>html,body{background-color:#0a0c10;color:#b7bccc}</style>

    <!-- GoatCounter analytics (privacy-friendly, no cookies) — dashboard at https://silo-ext.goatcounter.com/ -->
    <script data-goatcounter="https://silo-ext.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header" id="site-header">
        <a class="brand" href="https://getsilo.dev">
          <img class="brand-mark" src="/silo-icon.png" alt="" width="44" height="44" />
          <span>Silo</span>
        </a>
        <button
          type="button"
          class="site-nav-toggle"
          id="site-nav-toggle"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="site-primary-nav"
        >
          <span class="site-nav-toggle-icon" aria-hidden="true">
            <i></i><i></i><i></i>
          </span>
        </button>
        <nav class="site-nav" id="site-primary-nav" aria-label="Primary">
          <a href="/">Extensions</a>
          <a href="https://getsilo.dev/guide/">Docs</a>
          <a href="https://getsilo.dev/changelog">Changelog</a>
          <a href="https://github.com/silo-code/extensions-registry">GitHub</a>
          <a
            class="site-nav-download"
            href="https://github.com/silo-code/silo/releases/latest"
            data-download-link
          >
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true" data-download-icon>
              <path d="M12.67 8.58c-.02-2.02 1.65-2.99 1.72-3.04-.94-1.37-2.4-1.56-2.92-1.58-1.24-.13-2.43.73-3.06.73-.63 0-1.61-.71-2.65-.69-1.36.02-2.62.79-3.32 2.01-1.42 2.46-.36 6.1 1.02 8.1.67.98 1.48 2.08 2.53 2.04 1.02-.04 1.4-.66 2.63-.66 1.23 0 1.57.66 2.65.64 1.1-.02 1.79-1 2.45-1.98.77-1.12 1.08-2.21 1.1-2.26-.02-.01-2.11-.81-2.15-3.21zM10.7 2.93c.56-.68.94-1.62.83-2.56-.81.03-1.78.54-2.36 1.22-.52.6-.97 1.56-.85 2.48.9.07 1.82-.46 2.38-1.14z" />
            </svg>
            Download
          </a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </div>

    <!-- Same markup/classes as apps/website's <footer class="home-footer">
         (App.tsx) — full-bleed dark strip below the gradient hero box,
         brand + link columns + copyright/social row. -->
    <footer class="home-footer">
      <div class="home-footer-inner">
        <div class="home-footer-top">
          <a class="home-footer-brand" href="https://getsilo.dev">
            <img src="/silo-icon.png" alt="" width="36" height="36" />
            <span>Silo</span>
          </a>
          <div class="home-footer-columns">
            <div class="home-footer-column">
              <h2>Silo</h2>
              <ul>
                <li><a href="https://github.com/silo-code/silo/releases/latest" data-download-link>Download</a></li>
                <li><a href="https://extensions.getsilo.dev">Extensions</a></li>
                <li><a href="https://getsilo.dev/roadmap">Roadmap</a></li>
                <li><a href="https://github.com/silo-code/silo">GitHub</a></li>
              </ul>
            </div>
            <div class="home-footer-column">
              <h2>Docs</h2>
              <ul>
                <li><a href="https://getsilo.dev/guide/">Getting started</a></li>
                <li><a href="https://getsilo.dev/api/">API reference</a></li>
                <li><a href="https://getsilo.dev/design/">Design system</a></li>
                <li><a href="https://getsilo.dev/guide/claude-skill">Build with Claude</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="home-footer-bottom">
          <p class="home-footer-meta">
            Silo © {year}
            <span aria-hidden="true"> · </span>
            <a href="https://github.com/silo-code/silo/blob/main/LICENSE">MIT License</a>
          </p>
          <div class="home-footer-social">
            <a href="https://github.com/silo-code/silo" aria-label="GitHub" title="GitHub">
              <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.65 7.65 0 0 1 8 3.58c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.19 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
              </svg>
            </a>
            <a href="https://x.com/silo_code" aria-label="X" title="X">
              <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M12.6 1.5h2.2L9.9 7.1l5.7 7.4h-4.5L7.7 9.8l-4 4.7H1.5l5.1-6L1 1.5h4.6l3.2 4.4 3.8-4.4zm-.8 12.1h1.2L4.3 2.7H3L11.8 13.6z" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile hamburger behavior — mirrors apps/website's App.tsx navOpen
         state: toggle button flips it, clicking a nav link closes it,
         Escape closes it. No outside-click dismiss on the real homepage
         either, so none added here. -->
    <script>
      const header = document.getElementById("site-header")!;
      const toggle = document.getElementById("site-nav-toggle")!;
      const nav = document.getElementById("site-primary-nav")!;

      function setOpen(open: boolean) {
        header.classList.toggle("is-nav-open", open);
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      }

      toggle.addEventListener("click", () => {
        setOpen(!header.classList.contains("is-nav-open"));
      });
      nav.querySelectorAll("a").forEach((a) => {
        a.addEventListener("click", () => setOpen(false));
      });
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setOpen(false);
      });
    </script>

    <!-- Platform-specific Download links — same behavior as apps/website's
         App.tsx (detectDownloadTarget for the icon, fetchLatestDownloadUrl
         to swap every [data-download-link] href from the generic releases
         page to a direct installer for the visitor's OS/arch). Every
         Download link on this site — the header pill and the footer list
         item — carries data-download-link and gets updated together. -->
    <script>
      import { detectDownloadTarget, fetchLatestDownloadUrl } from "../lib/download";

      const ICONS: Record<string, string> = {
        mac: '<path d="M12.67 8.58c-.02-2.02 1.65-2.99 1.72-3.04-.94-1.37-2.4-1.56-2.92-1.58-1.24-.13-2.43.73-3.06.73-.63 0-1.61-.71-2.65-.69-1.36.02-2.62.79-3.32 2.01-1.42 2.46-.36 6.1 1.02 8.1.67.98 1.48 2.08 2.53 2.04 1.02-.04 1.4-.66 2.63-.66 1.23 0 1.57.66 2.65.64 1.1-.02 1.79-1 2.45-1.98.77-1.12 1.08-2.21 1.1-2.26-.02-.01-2.11-.81-2.15-3.21zM10.7 2.93c.56-.68.94-1.62.83-2.56-.81.03-1.78.54-2.36 1.22-.52.6-.97 1.56-.85 2.48.9.07 1.82-.46 2.38-1.14z" />',
        windows:
          '<path d="M1 2.5 7.2 1.7v6.1H1zm7.5-.9L15 1v6.8H8.5zM1 8.9h6.2V15L1 14.1zm7.5 0H15V15l-6.5-.9z" />',
        linux:
          '<path d="M8 1.2c-1.4 0-2.6 1.5-2.6 3.5 0 1.3.4 2.4 1 3.1-.7.4-1.5 1.2-1.8 2.2-.3 1 .1 1.9.9 2.3-.5.5-.8 1.2-.8 1.9 0 .7.4 1.2 1.1 1.2.5 0 1-.2 1.4-.6.4.4.9.6 1.4.6s1-.2 1.4-.6c.4.4.9.6 1.4.6.7 0 1.1-.5 1.1-1.2 0-.7-.3-1.4-.8-1.9.8-.4 1.2-1.3.9-2.3-.3-1-1.1-1.8-1.8-2.2.6-.7 1-1.8 1-3.1 0-2-1.2-3.5-2.6-3.5zm-1.5 4.2a.7.7 0 1 1 0-1.4.7.7 0 0 1 0 1.4zm3 0a.7.7 0 1 1 0-1.4.7.7 0 0 1 0 1.4zM6.7 10c.3-.6 1-.9 1.8-.9.7 0 1.3.2 1.7.6l-.5.6c-.3-.3-.7-.4-1.2-.4-.5 0-.9.2-1.1.5L6.7 10z" />',
      };

      const target = detectDownloadTarget();

      const icon = document.querySelector("[data-download-icon]");
      if (icon) icon.innerHTML = ICONS[target.platform];

      void fetchLatestDownloadUrl(target).then((url) => {
        if (!url) return;
        document.querySelectorAll<HTMLAnchorElement>("[data-download-link]").forEach((a) => {
          a.href = url;
        });
      });
    </script>
  </body>
</html>

<style is:global>
  /* Palette pulled from getsilo.dev's *computed* styles (verified with
     Playwright against the live site), not just apps/website/src/styles.css
     read top-to-bottom — that file's early `.silo-home`/`.site-nav a`/etc.
     rules are superseded later in the same file by a "chrome pass" section
     (search "Silo chrome pass" in styles.css) that redefines background and
     text colors. --good/--warn/--bad have no homepage equivalent (no
     permission pills there) — those are Silo's real Dark theme-preset
     semantic colors (packages/extension-host/src/layout/theme.css). */
  :root {
    --bg: #0a0c10;
    --panel: #1a1b16;
    --border: #2b2c26;
    --text: #f2f4ea;
    --body-text: #b7bccc;
    --muted: #7a8099;
    --accent: #c5c9d2;
    --good: #9ece6a;
    --warn: #e0af68;
    --bad: #f7768e;
    --mono: "DM Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    --sans: Manrope, system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  * { box-sizing: border-box; }
  /* Reserve the scrollbar gutter site-wide so navigating between a tall
     page (catalog grid) and a short one (detail/publish) never shifts the
     centered content sideways — that shift is what read as "resizing"
     when clicking between pages. */
  html { overflow-y: scroll; scrollbar-gutter: stable; }
  /* The gradient lives on <body> — full viewport width — not on the 1440px
     .page-shell. On getsilo.dev the gradient is painted on #silo-home (the
     unbounded outer mount root; confirmed via computed styles: it's full
     viewport width, e.g. 2288px on a 2303px window, while the nested
     .page-shell inside it stays capped at 1440px and carries no background
     of its own). Painting the gradient on the capped box instead of the
     full-width one was the earlier bug — it made the color stop dead at
     1440px instead of spanning the window like the real homepage.
     font-synthesis: none matches #silo-home too — without it, the fallback
     font's synthesized bold/italic can visibly snap to the real Manrope
     weight once it loads, reading as a "jump". */
  body {
    margin: 0;
    color: var(--body-text);
    font-family: var(--sans);
    font-synthesis: none;
    font-size: 16px;
    line-height: 1.6;
    background:
      radial-gradient(ellipse at 78% 8%, #2a303c 0%, transparent 40%),
      radial-gradient(ellipse at 12% 72%, #1a222c 0%, transparent 44%),
      linear-gradient(135deg, #0b0f16 0%, #10141c 48%, #0a0c10 100%);
    background-attachment: fixed;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  /* Headings get the bright high-emphasis tone (matches .home-faq > h2 /
     .home-faq-item summary / .home-footer-brand on the homepage); body copy
     stays the softer --body-text. */
  h1, h2, h3 { color: var(--text); }

  /* Pure layout constraint now — no background of its own (mirrors the
     real .page-shell, nested inside the gradient-carrying root). */
  .page-shell {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 54px;
  }

  /* Mirrors apps/website's .site-header/.site-nav/.brand exactly (same
     height, gaps, colors, weights, no border) so the header is
     indistinguishable from getsilo.dev's. */
  .site-header {
    position: relative;
    height: 84px; display: flex; align-items: center; gap: 22px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex; align-items: center; gap: 9px;
    color: var(--body-text); font-weight: 800; letter-spacing: -0.04em; font-size: 19px;
  }
  .brand:hover { text-decoration: none; }
  .brand-mark { border-radius: 10px; display: block; }
  .site-nav {
    margin-left: auto; display: flex; align-items: center; flex-wrap: wrap;
    gap: 8px 22px; font-family: var(--sans);
  }
  .site-nav a:not(.site-nav-download) {
    color: var(--muted); font-size: 13px; font-weight: 500; font-family: var(--sans);
  }
  .site-nav a:not(.site-nav-download):hover { color: var(--text); text-decoration: none; }
  .site-nav-download {
    display: inline-flex; align-items: center; gap: 8px; margin-left: 6px;
    color: #0b0d17 !important; background: var(--text);
    border-radius: 999px; padding: 9px 16px 9px 14px;
    font-size: 13px; font-weight: 600; line-height: 1; font-family: var(--sans);
    transition: filter 0.15s ease;
  }
  .site-nav-download:hover { text-decoration: none; filter: brightness(0.94); }
  .site-nav-download svg { flex-shrink: 0; }
  /* Hamburger toggle — hidden until the 640px breakpoint below reveals it.
     Ported verbatim from apps/website/src/styles.css. */
  .site-nav-toggle {
    display: none; align-items: center; justify-content: center;
    margin-left: auto; width: 40px; height: 40px; padding: 0;
    border: 1px solid #2a3144; border-radius: 8px;
    background: transparent; color: #c5c9d2;
  }
  .site-nav-toggle-icon {
    display: flex; flex-direction: column; justify-content: center;
    gap: 4px; width: 18px;
  }
  .site-nav-toggle-icon i {
    display: block; height: 1.5px; background: currentColor; border-radius: 1px;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .site-header.is-nav-open .site-nav-toggle-icon i:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .site-header.is-nav-open .site-nav-toggle-icon i:nth-child(2) { opacity: 0; }
  .site-header.is-nav-open .site-nav-toggle-icon i:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }
  main { padding: 2.5rem 0 4rem; }

  /* Footer — ported verbatim from apps/website/src/styles.css's
     .home-footer* rules (same bg, border, spacing, typography). */
  .home-footer {
    margin-top: 0;
    padding: 56px 54px 40px;
    background: #0a0c12;
    border-top: 1px solid #1c2030;
  }
  .home-footer-inner { max-width: 1440px; margin: 0 auto; }
  .home-footer-top {
    display: flex; justify-content: space-between; gap: 48px 64px;
    flex-wrap: wrap; padding-bottom: 32px;
  }
  .home-footer-brand {
    display: inline-flex; align-items: center; gap: 10px;
    color: #f2f4ea; font-weight: 800; font-size: 18px; letter-spacing: -0.04em;
    text-decoration: none; align-self: flex-start;
  }
  .home-footer-brand:hover { text-decoration: none; }
  .home-footer-brand img { display: block; width: 36px; height: 36px; border-radius: 8px; }
  .home-footer-columns { display: flex; flex-wrap: wrap; gap: 40px 72px; }
  .home-footer-column h2 {
    margin: 0 0 16px; font-size: 13px; font-weight: 500; letter-spacing: 0.02em; color: #7a8099;
  }
  .home-footer-column ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .home-footer-column a { color: #f2f4ea; font-size: 14px; font-weight: 400; text-decoration: none; }
  .home-footer-column a:hover { color: var(--accent); text-decoration: none; }
  .home-footer-bottom {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 16px 24px; padding-top: 24px; border-top: 1px solid #1c2030;
  }
  .home-footer-meta { margin: 0; color: #7a8099; font-size: 13px; }
  .home-footer-meta a { color: #7a8099; text-decoration: none; }
  .home-footer-meta a:hover { color: #f2f4ea; }
  .home-footer-social { display: flex; align-items: center; gap: 8px; }
  .home-footer-social a {
    display: grid; place-items: center; width: 36px; height: 36px;
    color: #f2f4ea; border-radius: 8px; text-decoration: none;
  }
  .home-footer-social a:hover { background: rgb(242 244 234 / 6%); color: var(--accent); }

  /* Q&A disclosure list — ported verbatim from apps/website's
     .home-faq/.home-faq-item (App.tsx "Common questions" section) so any
     page can drop in the same accordion pattern the homepage uses. */
  .home-faq { margin: 0 auto 40px; max-width: 820px; }
  .home-faq > h2 {
    margin: 0 0 36px; color: var(--text); font-size: clamp(28px, 3.2vw, 40px);
    font-weight: 700; letter-spacing: -0.045em; text-align: center;
  }
  .home-faq-item { border-top: 1px solid #2a3144; }
  .home-faq-item:last-child { border-bottom: 1px solid #2a3144; }
  .home-faq-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 22px 4px; color: var(--text); font-size: 17px; font-weight: 600;
    letter-spacing: -0.02em; line-height: 1.35; cursor: pointer; list-style: none;
  }
  .home-faq-item summary::-webkit-details-marker { display: none; }
  .home-faq-item summary::after {
    content: "+"; flex-shrink: 0; width: 1.25em; color: #9aa1b5;
    font: 400 22px/1 var(--mono); text-align: center;
  }
  .home-faq-item[open] summary::after { content: "−"; }
  .home-faq-item summary:hover { color: #fff; }
  .home-faq-item p {
    margin: 0; padding: 0 2.5rem 22px 4px; max-width: 42rem;
    color: #7a8099; font-size: 15px; line-height: 1.65;
  }

  code, pre { font-family: var(--mono); }
  pre {
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 8px; padding: 0.9rem 1rem; overflow-x: auto; font-size: 0.88rem;
  }
  code { background: var(--panel); border-radius: 4px; padding: 0.1em 0.35em; font-size: 0.9em; }
  pre code { background: none; padding: 0; }
  .pill {
    display: inline-block; border: 1px solid var(--border); border-radius: 999px;
    padding: 0.05rem 0.6rem; font-size: 0.75rem; color: var(--muted);
    font-family: var(--mono);
  }
  .pill.perm { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 40%, transparent); }
  .pill.attested { color: var(--good); border-color: color-mix(in srgb, var(--good) 40%, transparent); }
  .pill.unavailable { color: var(--bad); border-color: color-mix(in srgb, var(--bad) 40%, transparent); }

  @media (max-width: 900px) {
    .page-shell { padding: 0 20px; }
  }
  /* No .home-footer override here — the real homepage doesn't have one
     either (checked apps/website/src/styles.css: .home-footer's
     `padding: 56px 54px 40px` is unconditional, no media query touches
     it), so the footer's side padding stays 54px even on phones there.
     Matching that exactly rather than inventing a narrower one. */
  @media (max-width: 640px) {
    .site-header { height: auto; min-height: 64px; flex-wrap: nowrap; padding: 12px 0; gap: 12px; }
    .site-nav-toggle { display: inline-flex; }
    .site-nav {
      display: none; position: absolute; top: calc(100% - 4px); left: 0; right: 0;
      z-index: 30; margin: 0; padding: 12px; flex-direction: column; flex-wrap: nowrap;
      align-items: stretch; gap: 4px; border: 1px solid #2a3144; border-radius: 10px;
      background: #0f1219; box-shadow: 0 16px 40px #00000088;
    }
    .site-header.is-nav-open .site-nav { display: flex; }
    .site-nav a:not(.site-nav-download) { padding: 12px 14px; border-radius: 8px; font-size: 15px; }
    .site-nav a:not(.site-nav-download):hover { background: #1a2030; }
    .site-nav-download { margin: 6px 0 0; justify-content: center; width: 100%; }
  }
</style>
